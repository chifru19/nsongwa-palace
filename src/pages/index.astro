---
---
<html>
  <head>
    <style>
      body { font-family: sans-serif; line-height: 1.6; margin: 0; padding: 0; background: #f4f4f4; }
      .hero { background: #8b0000; color: white; text-align: center; padding: 3rem 1rem; }
      .content { max-width: 900px; margin: 2rem auto; padding: 2rem; background: white; border-radius: 10px; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-top: 1rem; }
      .gallery img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }
      .project-box { background: #fff8dc; padding: 1.5rem; border-left: 5px solid #daa520; margin: 2rem 0; }
    </style>
  </head>
  <body>
    <header class="hero">
      <h1>Nsongwa Palace Construction</h1>
    </header>
    <main class="content">
      <section class="project-box">
        <h2>Construction Progress</h2>
        <div class="gallery">
          {Array.from({ length: 11 }).map((_, i) => (
            <img src={`/nsongwa-palace/assets/images/construction-${i + 1}.jpg`} alt={`Construction ${i + 1}`} />
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
