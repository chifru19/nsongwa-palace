---
const images = import.meta.glob('/public/assets/images/**/*.{jpg,jpeg,png}');
// Convert the glob object into an array of paths
const imagePaths = Object.values(images).map((_, path) => path); 
---

<div class="gallery" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px;">
  {Object.keys(images).map((path) => (
    <img src={path.replace('/public', '/nsongwa-palace')} alt="Gallery Image" style="width: 100%; height: auto; border-radius: 8px;" />
  ))}
</div>
