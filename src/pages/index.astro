---
---
<html>
  <head>
    <style>
      body { font-family: 'Segoe UI', sans-serif; line-height: 1.6; margin: 0; padding: 0; background: #f4f4f4; }
      .hero { background: #8b0000; color: white; text-align: center; padding: 3rem 1rem; }
      .hero img { border-radius: 50%; width: 150px; height: 150px; object-fit: cover; border: 4px solid white; }
      .content { max-width: 900px; margin: 2rem auto; padding: 2rem; background: white; border-radius: 10px; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-top: 1rem; }
      .gallery img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd; }
      .section-box { background: #fff; padding: 1.5rem; border-left: 5px solid #8b0000; margin: 2rem 0; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
      .project-box { border-left-color: #daa520; background: #fff8dc; }
      .video-container { margin-top: 1rem; }
      .video-container video { width: 100%; border-radius: 8px; }
      footer { background: #333; color: white; text-align: center; padding: 2rem; margin-top: 2rem; }
      footer a { color: #daa520; text-decoration: none; }
    </style>
  </head>
  <body>
    <header class="hero">
      <img src="/nsongwa-palace/assets/images/hero.jpg" alt="Fon Nsongwa" />
      <h1>Nsongwa Palace</h1>
    </header>

    <main class="content">
      <section class="section-box">
        <h2>Location</h2>
        <p><strong>Nsongwa Palace</strong><br> W426+QW, Bamenda, Cameroon</p>
        <p><a href="https://www.google.com/maps/search/?api=1&query=W426+QW+Bamenda+Cameroon" target="_blank">View on Google Maps</a></p>
      </section>

      <section class="section-box">
        <h2>Nsongwa Ceremony Video</h2>
        <div class="video-container">
          <video controls>
            <source src="/nsongwa-palace/assets/videos/nsongwa-ceremony.mp4" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </section>

      <section class="section-box">
        <h2>Jubilee Collection</h2>
        <div class="gallery">
          {Object.entries(import.meta.glob('/public/assets/images/jubilee/*.{jpg,jpeg,png,JPG,JPEG}', {eager: true})).map(([path, mod]) => (
            <img src={path.replace('/public', '/nsongwa-palace')} alt="Jubilee" />
          ))}
        </div>
      </section>

      <section class="section-box project-box">
        <h2>Construction Progress</h2>
        <div class="gallery">
          {Object.entries(import.meta.glob('/public/assets/images/construction/*.{jpg,jpeg,png,JPG,JPEG}', {eager: true})).map(([path, mod]) => (
            <img src={path.replace('/public', '/nsongwa-palace')} alt="Construction" />
          ))}
        </div>
      </section>

      <section class="section-box">
        <h2>General Gallery</h2>
        <div class="gallery">
          {Object.entries(import.meta.glob('/public/assets/images/gallery-*.{jpg,jpeg,png,JPG,JPEG}', {eager: true})).map(([path, mod]) => (
            <img src={path.replace('/public', '/nsongwa-palace')} alt="Gallery" />
          ))}
        </div>
      </section>
    </main>

    <footer>
      <p><strong>Frank Fru</strong> | Engineer & Son of the Land</p>
      <p><a href="https://frankfru.com">Portfolio</a> | <a href="https://github.com/chifru19">GitHub</a> | <a href="https://www.linkedin.com/in/frank-fru">LinkedIn</a></p>
      <p>Contact: <a href="mailto:chifru19@googlemail.com">chifru19@googlemail.com</a></p>
    </footer>
  </body>
</html>
