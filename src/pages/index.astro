<html>
  <head>
    <style>
      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
      .gallery img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }
    </style>
  </head>
  <body>
    <h2>Construction Progress</h2>
    <div class="gallery">
      {['1','2','4','5','6','7','8','9'].map((num) => (
        <img src={`/nsongwa-palace/assets/images/construction-${num}.jpg`} alt={`Construction ${num}`} />
      ))}
    </div>
  </body>
</html>
