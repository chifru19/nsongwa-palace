---
---
<html>
  <head>
    <style>
      body { font-family: sans-serif; margin: 0; padding: 0; }
      .hero { background-color: #8b0000; color: white; text-align: center; padding: 2rem; }
      .hero img { border-radius: 50%; width: 150px; height: 150px; object-fit: cover; border: 4px solid white; }
      .content { max-width: 800px; margin: 0 auto; padding: 1rem; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 1rem; }
      .gallery img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }
    </style>
  </head>
  <body>
    <div class="hero">
      <img src="/nsongwa-palace/assets/images/hero.jpg" alt="Fon Nsongwa" />
      <h1>Nsongwa Palace</h1>
    </div>
    <div class="content">
      <h2>Gallery</h2>
      <div class="gallery">
        <img src="/nsongwa-palace/assets/images/gallery-1.jpg" alt="Gallery 1" />
        <img src="/nsongwa-palace/assets/images/gallery-2.jpg" alt="Gallery 2" />
        <img src="/nsongwa-palace/assets/images/gallery-3.jpg" alt="Gallery 3" />
        <img src="/nsongwa-palace/assets/images/gallery-4.jpg" alt="Gallery 4" />
        <img src="/nsongwa-palace/assets/images/gallery-5.jpg" alt="Gallery 5" />
        <img src="/nsongwa-palace/assets/images/gallery-6.jpg" alt="Gallery 6" />
        <img src="/nsongwa-palace/assets/images/gallery-7.jpg" alt="Gallery 7" />
        <img src="/nsongwa-palace/assets/images/gallery-8.jpg" alt="Gallery 8" />
        <img src="/nsongwa-palace/assets/images/gallery-9.jpg" alt="Gallery 9" />
      </div>
    </div>
  </body>
</html>
